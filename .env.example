# Copy values to the hosting environment; the framework does NOT auto-load .env.
APP_NAME=Rahdana
APP_ENV=local
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rahdana
DB_USERNAME=
DB_PASSWORD=
# Registration is off by default to prevent public signups until deployment is secured.
ALLOW_REGISTRATION=false
